--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h618-t95max.dts
@@ -0,0 +1,114 @@
+/dts-v1/;
+#include "sun50i-h616.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+
+/ {
+	model = "T95 Max (H618/AXP313A)";
+	compatible = "allwinner,sun50i-h618", "allwinner,sun50i-h616";
+
+	aliases {
+		ethernet0 = &emac0;
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+};
+
+/* AXP313A PMIC configured via I2C */
+&r_i2c {
+	status = "okay";
+	axp313: pmic@36 {
+		compatible = "x-powers,axp313a";
+		reg = <0x36>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+
+		regulators {
+			reg_dcdc1: dcdc1 {
+				regulator-name = "vdd-cpux";
+				regulator-min-microvolt = <810000>;
+				regulator-max-microvolt = <1100000>;
+				regulator-always-on;
+			};
+			reg_dcdc2: dcdc2 { regulator-name = "vdd-sys"; regulator-always-on; };
+			reg_dcdc3: dcdc3 { regulator-name = "vdd-dram"; regulator-always-on; };
+			reg_aldo1: aldo1 { regulator-name = "vcc-avcc"; regulator-always-on; };
+		};
+	};
+};
+
+&cpu0 { cpu-supply = <&reg_dcdc1>; };
+
+&mali {
+	status = "okay";
+	mali-supply = <&reg_dcdc1>;
+};
+
+&emac0 {
+	phy-handle = <&ext_rmii_phy>;
+	phy-mode = "rmii";
+	status = "okay";
+};
+
+&mmc1 {
+	vmmc-supply = <&reg_dcdc2>;
+	vqmmc-supply = <&reg_dcdc2>;
+	bus-width = <4>;
+	non-removable;
+	status = "okay";
+};
+
+&mmc2 {
+	vmmc-supply = <&reg_dcdc2>;
+	vqmmc-supply = <&reg_dcdc2>;
+	bus-width = <8>;
+	non-removable;
+	cap-mmc-hw-reset;
+	status = "okay";
+};
+
+&ehci0 { status = "okay"; };
+&ehci1 { status = "okay"; };
+&ohci0 { status = "okay"; };
+&ohci1 { status = "okay"; };
+&usbotg { status = "okay"; dr_mode = "host"; };
